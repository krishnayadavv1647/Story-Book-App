# =============================================================================
# StoryBook Studio — server environment
# =============================================================================
# Copy to `server/.env` and fill it in. `.env` is gitignored and must never be
# committed.
#
# Most settings are commented out: those are the defaults the server already
# uses, shown so they are discoverable. A blank or absent line means "use the
# default", so there is nothing to fill in that you do not care about.
#
# SECURITY RULE (enforced by tests/contract/no-secret-leak.test.js)
#   Nothing here may ever be copied into a VITE_* variable — Vite inlines every
#   VITE_* value into the browser bundle. The client learns about AI providers
#   only through the server API. Client settings live in client/.env.example.
# =============================================================================

# ----- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Public origin of the API, used to build absolute callback URLs.
SERVER_PUBLIC_URL=http://localhost:5000
# Browser origin(s) allowed by CORS. Comma-separated, no trailing slash.
CLIENT_ORIGIN=http://localhost:5173
# LOG_LEVEL=info

# ----- database --------------------------------------------------------------
# A replica set is REQUIRED in production: credit ledger writes and job state
# transitions use multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/storybook_studio
# MONGODB_DB_NAME=storybook_studio

# ----- auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
COOKIE_SECRET=
# COOKIE_DOMAIN=localhost
# COOKIE_SECURE=false
# BCRYPT_ROUNDS=12

# Encrypts each user's own provider API keys (BYOK) at rest. Required in
# production; generate with the same command as the JWT secrets above. Rotating
# it only invalidates stored keys (users re-enter them). In dev it falls back to
# COOKIE_SECRET, so it can be left blank locally.
APIKEY_ENC_SECRET=

# ----- Sign in with Google (optional) ----------------------------------------
# Enables the "Continue with Google" button using the server-side Authorization
# Code flow. Enabled only when BOTH the client id and secret are set; leave them
# blank to keep it off (email/password is unaffected either way).
#
# In the Google Cloud console (APIs & Services -> Credentials) create an OAuth
# 2.0 *Web application* client, then:
#   · under "Authorized redirect URIs" add the callback below, i.e.
#       http://localhost:5000/api/v1/auth/google/callback   (dev)
#     — it must EXACTLY match GOOGLE_REDIRECT_URI (or the default derived from
#       SERVER_PUBLIC_URL if you leave GOOGLE_REDIRECT_URI blank).
#   · copy the Client ID and Client secret here. The secret is a real secret and
#     never leaves the server (see SERVER_ONLY_SECRET_KEYS); the client needs
#     nothing.
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# ----- rate limits (requests per window) -------------------------------------
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_CHAT_MAX=30
# RATE_LIMIT_GENERATION_MAX=20
# RATE_LIMIT_UPLOAD_MAX=30
# RATE_LIMIT_EXPORT_MAX=10
# RATE_LIMIT_CALLBACK_MAX=120
# RATE_LIMIT_DEFAULT_MAX=300

# ----- Gemini (story generation) — SERVER ONLY -------------------------------
# You only need GEMINI_API_KEY. Everything commented out below is a default the
# server already uses; uncomment a line only to override it. A blank line means
# "use the default", so there is nothing to fill in that you do not care about.
# Uses the Interactions API: POST {BASE_URL}{INTERACTIONS_PATH}
# Confirmed against https://ai.google.dev/api/interactions.md.txt (2026-09-01).
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_INTERACTIONS_PATH=/v1beta/interactions
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=60000
# GEMINI_MAX_RETRIES=2
# GEMINI_TEMPERATURE=0.8
# Ceiling for one whole-book plan; billed by actual usage. Raise it for very
# long or very text-heavy books.
# GEMINI_MAX_OUTPUT_TOKENS=32768
# minimal | low | medium | high
# GEMINI_THINKING_LEVEL=low

# ----- Kie.ai (image generation) — SERVER ONLY -------------------------------
# You only need KIE_API_KEY. The paths and model below are the confirmed values
# from Kie.ai's unified jobs API (2026-09-01) and are already the defaults, so
# they are commented out — uncomment only to override.
#
# KIE_CALLBACK_SECRET signs the unguessable token in the callback URL. It is
# ours, not Kie.ai's. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KIE_API_KEY=
# KIE_BASE_URL=https://api.kie.ai
# KIE_CREATE_PATH=/api/v1/jobs/createTask
# KIE_STATUS_PATH=/api/v1/jobs/recordInfo
# The unified jobs API carries its version in the path; kept for adapters that
# need a separate version header.
# KIE_API_VERSION=
KIE_IMAGE_MODEL=nano-banana-pro
# Public origin of THIS server, used to build the callback URL.
# KIE_CALLBACK_URL=
# Kie.ai does NOT sign its callbacks. This secret signs an unguessable token
# into the callback path instead, and the payload is treated as a hint only —
# task state is always re-read from recordInfo before it is trusted.
KIE_CALLBACK_SECRET=
# A transient 5xx / 429 / timeout is retried this many times before the page
# is marked failed. Only failures the provider clearly did not act on.
# The provider refuses a longer prompt outright. Measured at 1000 for z-image;
# the page prompt is trimmed to fit rather than being rejected.
# KIE_MAX_PROMPT_CHARS=1000
# KIE_MAX_RETRIES=2
# KIE_RETRY_BASE_MS=700
# KIE_TIMEOUT_MS=60000
# KIE_MAX_POLL_ATTEMPTS=60
# KIE_POLL_INTERVAL_MS=3000

# ----- object storage (S3-compatible: AWS S3 or Cloudflare R2) ---------------
# For Cloudflare R2 set STORAGE_ENDPOINT to
#   https://<account-id>.r2.cloudflarestorage.com  and STORAGE_REGION to `auto`.
# s3 | local | memory. With no STORAGE_BUCKET set, `s3` falls back to `local`,
# which keeps images on disk so they survive a restart. `memory` is for tests
# only — it loses every image when the process exits.
STORAGE_DRIVER=s3
# Where the local driver writes. Defaults to server/.storage (gitignored).
# STORAGE_LOCAL_DIR=
STORAGE_ENDPOINT=
# STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
# STORAGE_SIGNED_URL_TTL_S=900
# UPLOAD_MAX_BYTES=10485760

# ----- job queue -------------------------------------------------------------
# `inline` runs jobs in-process (development only, no Redis required).
# `bullmq` requires REDIS_URL and is the production driver.
# QUEUE_DRIVER=inline
REDIS_URL=
# QUEUE_CONCURRENCY=3

# ----- credits ---------------------------------------------------------------
