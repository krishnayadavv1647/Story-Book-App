# =============================================================================
# StoryBook Studio — server environment
# =============================================================================
# Copy to `server/.env` and fill it in. `.env` is gitignored and must never be
# committed.
#
# Most settings are commented out: those are the defaults the server already
# uses, shown so they are discoverable. A blank or absent line means "use the
# default", so there is nothing to fill in that you do not care about.
#
# SECURITY RULE (enforced by tests/contract/no-secret-leak.test.js)
#   Nothing here may ever be copied into a VITE_* variable — Vite inlines every
#   VITE_* value into the browser bundle. The client learns about AI providers
#   only through the server API. Client settings live in client/.env.example.
# =============================================================================

# ----- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Public origin of the API, used to build absolute callback URLs.
SERVER_PUBLIC_URL=http://localhost:5000
# Browser origin(s) allowed by CORS. Comma-separated, no trailing slash.
CLIENT_ORIGIN=http://localhost:5173
# LOG_LEVEL=info

# ----- database --------------------------------------------------------------
# A replica set is REQUIRED in production: credit ledger writes and job state
# transitions use multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/storybook_studio
# MONGODB_DB_NAME=storybook_studio

# ----- auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
COOKIE_SECRET=
# COOKIE_DOMAIN=localhost
# COOKIE_SECURE=false
# BCRYPT_ROUNDS=12
# Refresh-cookie cross-site scope. Leave as `lax` for local dev / a same-domain
# deploy. Set to `none` when the frontend is on a DIFFERENT origin than the API
# (e.g. frontend on Vercel/Netlify, API on Render) — otherwise the session will
# not persist and every login bounces back to the sign-in page. `none` requires
# HTTPS on both ends (it forces Secure).
# COOKIE_SAMESITE=lax

# ----- Sign in with Google (optional) ----------------------------------------
# Enables the "Continue with Google" button using the server-side Authorization
# Code flow. Enabled only when BOTH the client id and secret are set; leave them
# blank to keep it off (email/password is unaffected either way).
#
# In the Google Cloud console (APIs & Services -> Credentials) create an OAuth
# 2.0 *Web application* client, then:
#   · under "Authorized redirect URIs" add the callback below, i.e.
#       http://localhost:5000/api/v1/auth/google/callback   (dev)
#     — it must EXACTLY match GOOGLE_REDIRECT_URI (or the default derived from
#       SERVER_PUBLIC_URL if you leave GOOGLE_REDIRECT_URI blank).
#   · copy the Client ID and Client secret here. The secret is a real secret and
#     never leaves the server (see SERVER_ONLY_SECRET_KEYS); the client needs
#     nothing.
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# ----- sign in with a one-time code ------------------------------------------
# Two PUBLIC endpoints: POST /api/v1/auth/otp/request and /auth/otp/verify.
# Another app's browser can call them directly — that is how a partner app
# registers someone without holding a secret of ours — which also means anybody
# else can. The auth rate limit and the numbers below are the only protection.
#
# An address nobody has used before gets an account, so this is the sign-UP path
# as well as the sign-in one.
#
# A code is ALSO what finishes an ordinary email/password signup: registering
# creates the account but issues no session until the code is typed back, and an
# unverified account that signs in with its password is sent one. So without the
# Resend settings below, NOBODY can complete a signup — fill those in first.
#
# How long a code lasts, how many wrong guesses burn it, and how long before the
# same address may ask for another.
# OTP_CODE_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_S=60

# ----- transactional email (Resend) — SERVER ONLY ----------------------------
# Sends the password-reset link. Optional: leave RESEND_API_KEY or MAIL_FROM
# blank and the server sends no mail — in development the reset link is printed
# to the server log instead (and returned as `devToken`), which is enough to
# work locally. In PRODUCTION, without these, a user who forgets their password
# has no way back in.
#
# Setup: create an API key at https://resend.com/api-keys, and verify the
# sending domain under Domains (add the DNS records it gives you). Resend
# refuses to send from an unverified domain, so MAIL_FROM must use one you have
# verified — or, for a quick test only, `onboarding@resend.dev`, which can only
# deliver to your own Resend account address.
RESEND_API_KEY=
# The From header, e.g. `StoryBook Studio <no-reply@yourdomain.com>`. Blank
# keeps mail off even when a key is set — a wrong sender fails every send.
MAIL_FROM=
# Optional Reply-To, for when the From above is an unmonitored no-reply box.
# MAIL_REPLY_TO=support@yourdomain.com
# How long to wait for Resend before giving up on one send.
# MAIL_TIMEOUT_MS=15000

# ----- rate limits (requests per window) -------------------------------------
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_CHAT_MAX=30
# RATE_LIMIT_GENERATION_MAX=20
# RATE_LIMIT_UPLOAD_MAX=30
# RATE_LIMIT_EXPORT_MAX=10
# RATE_LIMIT_CALLBACK_MAX=120
# RATE_LIMIT_DEFAULT_MAX=300

# ----- Gemini (story generation) — SERVER ONLY -------------------------------
# You only need GEMINI_API_KEY. Everything commented out below is a default the
# server already uses; uncomment a line only to override it. A blank line means
# "use the default", so there is nothing to fill in that you do not care about.
# Uses the Interactions API: POST {BASE_URL}{INTERACTIONS_PATH}
# Confirmed against https://ai.google.dev/api/interactions.md.txt (2026-09-01).
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_INTERACTIONS_PATH=/v1beta/interactions
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=60000
# GEMINI_MAX_RETRIES=2
# GEMINI_TEMPERATURE=0.8
# Ceiling for one whole-book plan; billed by actual usage. Raise it for very
# long or very text-heavy books.
# GEMINI_MAX_OUTPUT_TOKENS=32768
# minimal | low | medium | high
# GEMINI_THINKING_LEVEL=low

# ----- Kie.ai (image generation) — SERVER ONLY -------------------------------
# You only need KIE_API_KEY. The paths and model below are the confirmed values
# from Kie.ai's unified jobs API (2026-09-01) and are already the defaults, so
# they are commented out — uncomment only to override.
#
# KIE_CALLBACK_SECRET signs the unguessable token in the callback URL. It is
# ours, not Kie.ai's. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KIE_API_KEY=
# KIE_BASE_URL=https://api.kie.ai
# KIE_CREATE_PATH=/api/v1/jobs/createTask
# KIE_STATUS_PATH=/api/v1/jobs/recordInfo
# The unified jobs API carries its version in the path; kept for adapters that
# need a separate version header.
# KIE_API_VERSION=
KIE_IMAGE_MODEL=nano-banana-pro
# Public origin of THIS server, used to build the callback URL.
# KIE_CALLBACK_URL=
# Kie.ai does NOT sign its callbacks. This secret signs an unguessable token
# into the callback path instead, and the payload is treated as a hint only —
# task state is always re-read from recordInfo before it is trusted.
KIE_CALLBACK_SECRET=
# A transient 5xx / 429 / timeout is retried this many times before the page
# is marked failed. Only failures the provider clearly did not act on.
# The provider refuses a longer prompt outright. Measured at 1000 for z-image;
# the page prompt is trimmed to fit rather than being rejected.
# KIE_MAX_PROMPT_CHARS=1000
# KIE_MAX_RETRIES=2
# KIE_RETRY_BASE_MS=700
# KIE_TIMEOUT_MS=60000
# KIE_MAX_POLL_ATTEMPTS=60
# KIE_POLL_INTERVAL_MS=3000

# ----- object storage (S3-compatible: AWS S3 or Cloudflare R2) ---------------
# For Cloudflare R2 set STORAGE_ENDPOINT to
#   https://<account-id>.r2.cloudflarestorage.com  and STORAGE_REGION to `auto`.
# s3 | local | memory. With no STORAGE_BUCKET set, `s3` falls back to `local`,
# which keeps images on disk so they survive a restart. `memory` is for tests
# only — it loses every image when the process exits.
STORAGE_DRIVER=s3
# Where the local driver writes. Defaults to server/.storage (gitignored).
# STORAGE_LOCAL_DIR=
STORAGE_ENDPOINT=
# STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
# STORAGE_SIGNED_URL_TTL_S=900
# UPLOAD_MAX_BYTES=10485760

# ----- job queue -------------------------------------------------------------
# `inline` runs jobs in-process (development only, no Redis required).
# `bullmq` requires REDIS_URL and is the production driver.
# QUEUE_DRIVER=inline
REDIS_URL=
# QUEUE_CONCURRENCY=3

# ----- credits ---------------------------------------------------------------
# Generation is paid for in credits, out of the balance every account opens
# with. The provider keys above are the SERVER's — users do not bring their own.
#
# All five are defaults the server already uses, so there is nothing to fill in
# unless you want different pricing. Changing a price affects future charges
# only: existing balances are untouched, and history keeps the price that was
# actually paid.
#
# At these defaults a 12-page book costs 10 for the plan, 5 × 14 for its pages
# and two covers, and 5 per character — about 90 credits, so a new account can
# make roughly five books before it needs a top-up. There is no billing yet:
# an admin tops an account up with POST /admin/users/:userId/credits.
# CREDITS_SIGNUP_GRANT=80
# Bonus sign-up links (made in Admin → Plans → Bonus links) are the usual way to
# hand a plan to new readers: a link's plan REPLACES the opening grant above, so
# a bonus account holds exactly what the plan gives.
#
# The plan every brand-new account is put on, whichever way it signed up — how a
# welcome bonus or a bundled-app bonus is delivered. `scripts/create-signup-plan.js`
# creates one. When it is set, the plan's credits are what an account opens with,
# so CREDITS_SIGNUP_GRANT should usually be 0 or the two stack.
#
# Note that the OTP endpoints above are public: with a plan set here, anyone who
# can reach them can claim it by entering an address they control.
SIGNUP_PLAN_KEY=
# CREDITS_STORY_PLAN=10
# CREDITS_IMAGE=5
# CREDITS_CHARACTER=5
# CREDITS_CHAT=1
