{
  "name": "@storybook-studio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:memdb": "node scripts/dev-memory-db.js",
    "dev:aistub": "node scripts/dev-ai-stub.js",
    "dev:memdb:stub": "node scripts/dev-memory-db-stub.js",
    "dev:stub:api": "concurrently -n stub,server -c magenta,blue \"node scripts/dev-ai-stub.js\" \"node scripts/dev-memory-db-stub.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@napi-rs/canvas": "^0.1.100",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "resend": "^6.26.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
